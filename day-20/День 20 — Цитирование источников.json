    {
      "parameters": {
        "jsCode": "const questions = [\n  'Что такое JOIN?',\n  'Разница между WHERE и HAVING?',\n  'Что такое транзакция?',\n  'Какие виды JOIN бывают?',\n  'Что такое индекс?',\n  'Что такое list comprehension?',\n  'Разница между списком и кортежем?',\n  'Что такое генератор?',\n  'Что такое декоратор?',\n  'Разница между == и is?'\n];\n\nreturn questions.map(q => ({ json: { question: q } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2080,
        320
      ],
      "id": "66a0076d-2256-4499-b73a-7c9c1796a6ea",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\n// Твой Cloudflare API\nconst CF_ACCOUNT_ID = '0ad5ca22e6b34abbadc2cfcaba6bfef1';\nconst CF_API_TOKEN_PLACEHOLDER;\nconst CF_MODEL = '@cf/qwen/qwen3-30b-a3b-fp8';\nconst CF_URL = `https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/ai/v1/chat/completions`;\n\nfor (const item of items) {\n  const question = item.json.question;\n\n  try {\n    // 1. Ответ бота\n    const answerResp = await this.helpers.httpRequest({\n      method: 'POST',\n      url: CF_URL,\n      headers: {\n        'Authorization': `Bearer ${CF_API_TOKEN}`,\n        'Content-Type': 'application/json'\n      },\n      body: {\n        model: CF_MODEL,\n        messages: [\n          { role: 'system', content: 'Ты — AI-ассистент по SQL и Python. Отвечай кратко (2-3 предложения).' },\n          { role: 'user', content: question }\n        ]\n      },\n      json: true\n    });\n\n    const answer = answerResp.choices[0].message.content;\n\n    // 2. Оценка судьи\n    const judgeResp = await this.helpers.httpRequest({\n      method: 'POST',\n      url: CF_URL,\n      headers: {\n        'Authorization': `Bearer ${CF_API_TOKEN}`,\n        'Content-Type': 'application/json'\n      },\n      body: {\n        model: CF_MODEL,\n        messages: [\n          { role: 'system', content: 'Ты — строгий судья. Оцени ответ по шкале 1-10. Верни ТОЛЬКО число.' },\n          { role: 'user', content: `Вопрос: ${question}\\n\\nОтвет: ${answer}\\n\\nОценка (1-10):` }\n        ]\n      },\n      json: true\n    });\n\n    const scoreText = judgeResp.choices[0].message.content.trim();\n    const score = parseFloat(scoreText.match(/\\d+/)?.[0] || '0');\n\n    results.push({\n      json: {\n        question: question,\n        answer: answer.slice(0, 150),\n        score: score\n      }\n    });\n\n  } catch (error) {\n    results.push({\n      json: {\n        question: question,\n        answer: 'ОШИБКА',\n        score: 0,\n        error: error.message\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1872,
        320
      ],
      "id": "ce919508-aaa0-4361-9e88-751414036484",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst scores = items\n  .map(i => parseFloat(i.json.score))\n  .filter(s => !isNaN(s) && s > 0);\n\nconst avg = scores.length > 0 \n  ? (scores.reduce((a, b) => a + b, 0) / scores.length).toFixed(2)\n  : 0;\n\nreturn [{\n  json: {\n    total_questions: items.length,\n    valid_scores: scores.length,\n    average_score: avg,\n    min_score: Math.min(...scores),\n    max_score: Math.max(...scores),\n    results: items.map(i => ({\n      question: i.json.question,\n      score: i.json.score\n    }))\n  }\n}];"
      },
